<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- No parent: this POM is the top of the inheritance chain for every AdPilot service. -->
  <groupId>io.github.ttads</groupId>
  <artifactId>platform-parent</artifactId>
  <!-- CI-friendly version; see the root pom.xml for how it is computed and flattened. -->
  <version>${revision}</version>
  <packaging>pom</packaging>

  <name>AdPilot Platform Parent</name>
  <description>
    Shared parent for all AdPilot microservices. Imports platform-dependencies
    for dependency version management and centralizes ALL pluginManagement
    (compiler, surefire/failsafe test wiring, jacoco, spring-boot-maven-plugin
    pin) so individual services only declare what they use.
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>21</maven.compiler.release>

    <!--
      The version of platform-dependencies this parent imports (below) is
      ${revision}, the same CI-friendly property that versions this POM, and
      NOTHING ELSE may stand in for it:

      - Not ${project.version}: this POM is inherited via <parent> by every
        service, and Maven resolves project.* against the CONSUMING project's
        effective model, so it would import whatever version each service
        happens to declare, not platform-dependencies' released version.
      - Not a dedicated property such as platform-bom.version either: a
        property reference stays a live expression in the published POM, and
        a consumer that defines a property of the same name overrides the
        parent's value (verified: a consumer setting platform-bom.version to
        9.9.9 made this POM import platform-dependencies:9.9.9 and fail at
        model-build time). Property names are not a namespace.

      What makes ${revision} safe is not the name but flatten-maven-plugin:
      the published POM carries the resolved LITERAL in both <version> and
      the import below, so there is no expression left for a consumer to
      shadow. The invariant to keep is "the published import coordinate is a
      literal", and the flatten execution at the bottom of this file is what
      guarantees it.
    -->
    <revision>0.0.0-SNAPSHOT</revision>
    <flatten-maven-plugin.version>1.7.3</flatten-maven-plugin.version>

    <!--
      BOM import (below) only brings dependencyManagement, not properties,
      so annotation-processor and plugin versions that must match
      platform-dependencies are re-declared here. Keep these in sync with
      platform-dependencies/pom.xml when bumping versions.
    -->
    <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
    <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
    <lombok.version>1.18.46</lombok.version>
    <mapstruct.version>1.6.3</mapstruct.version>
    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-failsafe-plugin.version>3.5.6</maven-failsafe-plugin.version>
    <maven-jar-plugin.version>3.5.0</maven-jar-plugin.version>
    <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
    <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    <spring-boot-maven-plugin.version>3.5.16</spring-boot-maven-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.ttads</groupId>
        <artifactId>platform-dependencies</artifactId>
        <version>${revision}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>

        <!--
          Annotation processor order matters: lombok must run before
          lombok-mapstruct-binding (which teaches MapStruct to see Lombok's
          generated accessors) which must run before mapstruct-processor.
        -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <!--
              Required for Spring Security method-security SpEL expressions like
              @PreAuthorize("...#orgId...") to resolve parameter names at runtime.
              Spring Framework 6.1 removed LocalVariableTableParameterNameDiscoverer,
              leaving the "-parameters" class-file attribute as the only remaining
              source of parameter names; SpEL fails SILENTLY (an unresolvable #var
              evaluates to null rather than throwing), so without this every
              @PreAuthorize using a #paramName reference fails closed for every
              caller, indistinguishable from "working" until an end-to-end test
              asserts a legitimate, correctly-privileged caller actually succeeds,
              not just that an under-privileged one is denied. Spring Boot's own
              parent POM sets this by default; we set it explicitly since
              platform-parent intentionally does not inherit from it. Discovered via
              identity-service's T10 OrgAuthorizationEndToEndIT (see its build log
              for the concrete repro: ADMIN caller measured with orgId=null).
            -->
            <parameters>true</parameters>
            <annotationProcessorPaths>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
              </path>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok-mapstruct-binding</artifactId>
                <version>${lombok-mapstruct-binding.version}</version>
              </path>
              <path>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>

        <!-- Unit tests only: surefire's default includes (**/*Test.java etc.) never match *IT.java. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>

        <!-- Integration tests: only **/*IT.java, run in the integration-test/verify phases. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
          <configuration>
            <includes>
              <include>**/*IT.java</include>
            </includes>
          </configuration>
          <executions>
            <execution>
              <id>integration-tests</id>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <!-- Coverage: instrument at initialize, report once `verify` has run both test phases. -->
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco-maven-plugin.version}</version>
          <executions>
            <execution>
              <id>prepare-agent</id>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
            </execution>
            <execution>
              <id>report-on-verify</id>
              <phase>verify</phase>
              <goals>
                <goal>report</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <!--
          Version pinned only. No repackage execution bound here: a shared,
          service-wide, or entity/security module must never produce an
          executable fat jar. Only <svc>-api opts in with its own execution.
        -->
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot-maven-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>

      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>

      <!--
        Bakes the CI-computed ${revision} into the POM that is installed and
        deployed (see the properties comment above). inherited=false is
        load-bearing: everything else in this <plugins> block runs in every
        service, but flatten must run only on this reactor. A service versions
        itself however it likes and must not have its installed POM rewritten
        by a plugin it never asked for.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>${flatten-maven-plugin.version}</version>
        <inherited>false</inherited>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>resolveCiFriendliesOnly</flattenMode>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
