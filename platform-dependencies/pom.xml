<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.ttads</groupId>
  <artifactId>platform-dependencies</artifactId>
  <!-- CI-friendly version; see the root pom.xml for how it is computed and flattened. -->
  <version>${revision}</version>
  <packaging>pom</packaging>

  <name>AdPilot Platform Dependencies (BOM)</name>
  <description>
    Pure Bill-of-Materials for the AdPilot platform: dependencyManagement
    only. The one plugin below (flatten) exists solely to bake the CI-computed
    version into the published POM; it manages no dependency and configures
    no build step a consumer could inherit (a BOM is imported, never
    inherited). Every version referenced here is expressed through a property
    so a single-line bump upgrades every consuming service. Zero JUnit 4 is
    pulled in transitively anywhere in this BOM.
  </description>

  <!--
    Properties are kept in strict alphabetical order (hard rule). Every
    version used anywhere in this file MUST be a property reference.
  -->
  <properties>
    <flatten-maven-plugin.version>1.7.3</flatten-maven-plugin.version>
    <keycloak-admin-client.version>26.0.10</keycloak-admin-client.version>
    <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
    <lombok.version>1.18.46</lombok.version>
    <mapstruct.version>1.6.3</mapstruct.version>
    <revision>0.0.0-SNAPSHOT</revision>
    <spring-boot.version>3.5.16</spring-boot.version>
    <spring-cloud.version>2025.0.3</spring-cloud.version>
    <springdoc-openapi.version>2.8.17</springdoc-openapi.version>
    <testcontainers-keycloak.version>3.9.1</testcontainers-keycloak.version>
    <testcontainers.version>1.21.4</testcontainers.version>
  </properties>

  <dependencyManagement>
    <dependencies>

      <!-- Spring Boot 3.5.x release train. -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!--
        Spring Cloud 2025.0.x ("Northfields") is the release train certified
        against Spring Boot 3.5.x per the official Spring Cloud compatibility
        matrix: https://github.com/spring-cloud/spring-cloud-release/wiki/Supported-Versions
        (Spring Cloud 2025.0.x <-> Spring Boot 3.5.x).
      -->
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Testcontainers 1.21.x BOM. -->
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- springdoc OpenAPI UI, one version per service. -->
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc-openapi.version}</version>
      </dependency>

      <!-- Lombok, compile-time only (annotation processor). -->
      <dependency>
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok</artifactId>
        <version>${lombok.version}</version>
        <scope>provided</scope>
      </dependency>

      <!-- MapStruct runtime + annotation processor. -->
      <dependency>
        <groupId>org.mapstruct</groupId>
        <artifactId>mapstruct</artifactId>
        <version>${mapstruct.version}</version>
      </dependency>
      <dependency>
        <groupId>org.mapstruct</groupId>
        <artifactId>mapstruct-processor</artifactId>
        <version>${mapstruct.version}</version>
        <scope>provided</scope>
      </dependency>

      <!-- Bridges Lombok-generated getters/setters into MapStruct mappers. -->
      <dependency>
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok-mapstruct-binding</artifactId>
        <version>${lombok-mapstruct-binding.version}</version>
        <scope>provided</scope>
      </dependency>

      <!-- Keycloak admin REST client, used by identity-service's sync layer. -->
      <dependency>
        <groupId>org.keycloak</groupId>
        <artifactId>keycloak-admin-client</artifactId>
        <version>${keycloak-admin-client.version}</version>
      </dependency>

      <!-- Testcontainers module for spinning up ephemeral Keycloak realms in ITs. -->
      <dependency>
        <groupId>com.github.dasniko</groupId>
        <artifactId>testcontainers-keycloak</artifactId>
        <version>${testcontainers-keycloak.version}</version>
        <scope>test</scope>
      </dependency>

      <!--
        flyway-core / flyway-database-postgresql / postgresql driver are
        intentionally NOT managed here: Spring Boot 3.5.x's dependency BOM
        already pins compatible versions of all three, and Flyway's own
        Postgres support tracks the Boot-managed driver version. Overriding
        them here would just create a second version to keep in sync.
      -->

      <!-- JUnit 5 only: exclude the vintage (JUnit 4) engine Boot otherwise pulls in. -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-test</artifactId>
        <version>${spring-boot.version}</version>
        <scope>test</scope>
        <exclusions>
          <exclusion>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
          </exclusion>
        </exclusions>
      </dependency>

    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>${flatten-maven-plugin.version}</version>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>resolveCiFriendliesOnly</flattenMode>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
